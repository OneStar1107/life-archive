@use '../../styles/mixins.scss' as m;

.page {
  flex: 1;
  background-color: var(--color-bg);
}

// ★ 不用 vh 单位
.body {
  flex: 1;
  width: 100%;
}

// ── 头部 ─────────────────────────────────────────────────
.head {
  width: 100%;
  @include m.content-constrain;
  flex-direction: column;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
  padding-top: t.$space-md;
  padding-bottom: t.$space-lg;
}

.head-title {
  font-size: t.$font-xl;
  font-weight: t.$weight-bold;
  line-height: t.$line-height-tight;
  color: var(--color-text-1);
}

.head-sub {
  margin-top: t.$space-sm;
  font-size: t.$font-sm;
  line-height: t.$line-height-loose;
  color: var(--color-text-2);
}

// ── 正文 ─────────────────────────────────────────────────
.content {
  width: 100%;
  @include m.content-constrain;
  flex-direction: column;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
}

.chapter {
  margin-bottom: t.$space-lg;
}

.chapter-title {
  font-size: t.$font-md;
  font-weight: t.$weight-semibold;
  line-height: t.$line-height-tight;
  color: var(--color-text-1);
  margin-bottom: t.$space-sm;
}

.chapter-body {
  flex-direction: column;
}

.para {
  font-size: t.$font-sm;
  line-height: t.$line-height-loose;
  color: var(--color-text-2);
  margin-bottom: t.$space-xs;
}

.para--gap {
  margin-top: t.$space-xs;
}

.item {
  font-size: t.$font-sm;
  line-height: t.$line-height-loose;
  color: var(--color-text-2);
  margin-bottom: t.$space-xs;
}

.tail-gap {
  height: t.$space-sm;
  width: 100%;
}

// ── 底部操作 ─────────────────────────────────────────────
.foot {
  width: 100%;
  @include m.content-constrain;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
}

.foot-hint {
  margin-top: t.$space-sm;
  font-size: t.$font-xs;
  line-height: t.$line-height-normal;
  color: var(--color-text-3);
  text-align: center;
}

// ── 底部安全区 ───────────────────────────────────────────
.safe-gap {
  @include m.safe-bottom(t.$space-lg);
  width: 100%;
}
</style>
