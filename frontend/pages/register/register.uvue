<!--
  pages/register/register —— 注册
  ══════════════════════════════════════════════════════════════
  四个字段：手机号 / 密码 / 确认密码 / 昵称（可选）

  ★ 三个刻意的设计决定：
    1. 密码强度提示放在输入框下方而不是独立卡片：
       强度是「边打字边看」的信息，位置太远就失去意义了。
    2. 强度规则与后端 PASSWORD_WEAK（10008）保持同一套口径：
       「至少 8 位且包含字母与数字」。两端口径不一致会让用户
       在端上看到「强」却被后端拒绝。
    3. 隐私政策勾选未完成时按钮 disabled，而不是点了再弹 Toast。
       后端注册接口本身不校验 consent（那是users/consent 接口的事），
       但产品上我们要求先知道再说。

  设计约束：
    1. 全部颜色/间距/圆角走 var(--xxx) 与 t.$xxx，页面内零字面量。
    2. 文字全部包在 <text> 里（红线第 1 条）。
-->
<template>
  <view class="page" :class="themeClass">
    <AppNavBar title="创建账号" :show-back="true" />

    <scroll-view class="body" scroll-y>
      <view v-if="showLoggedIn" class="switch-bar">
        <text class="switch-text">当前已登录：{{ displayName }}</text>
        <view class="switch-action" @click="onSwitchAccount">
          <text class="switch-action-text">退出并切换</text>
        </view>
      </view>

      <view class="head">
        <text class="head-title">先给我一个能找回你的名字</text>
        <text class="head-sub">只有手机号和密码。别的都可以以后再补。</text>
      </view>

      <view class="form">
        <AppInput
          v-model="phone"
          label="手机号"
          placeholder="请输入手机号"
          type="number"
          :maxlength="11"
          clearable
          :error="phoneError"
        />

        <view class="gap" />

        <AppInput
          v-model="password"
          label="密码"
          placeholder="至少 8 位，含字母和数字"
          :maxlength="32"
          :error="pwdError"
          :hint="pwdHint"
        />

        <!-- 强度条：弱 / 中 / 强 三档。
             用 class 切换颜色，不做渐变（渐变里套 var() 三端解析不稳） -->
        <view v-if="password.length > 0" class="strength">
          <view class="strength-bar">
            <view class="strength-fill" :class="strengthClass" />
          </view>
          <text class="strength-text" :class="strengthTextClass">{{ strengthLabel }}</text>
        </view>

        <view class="gap" />

        <AppInput
          v-model="confirm"
          label="再输一次"
          placeholder="确认密码"
          :maxlength="32"
          :error="confirmError"
        />

        <view class="gap" />

        <AppInput
          v-model="nickname"
          label="怎么称呼你（可以不填）"
          placeholder="比如：小澈"
          :maxlength="16"
          clearable
        />
      </view>

      <!-- 隐私政策勾选：未勾选时注册按钮 disabled -->
      <view class="consent">
        <view class="consent-row" @click="onToggleConsent">
          <view class="checkbox" :class="agreed ? 'checkbox--on' : ''">
            <text v-if="agreed" class="checkbox-tick">✓</text>
          </view>
          <text class="consent-text">我已阅读并同意</text>
        </view>
        <view class="consent-link" @click="onGoPrivacy">
          <text class="consent-link-text">《隐私政策》</text>
        </view>
      </view>

      <view v-if="bannerError != ''" class="banner">
        <view class="banner-box">
          <text class="banner-text">{{ bannerError }}</text>
        </view>
      </view>

      <view class="actions">
        <AppButton
          variant="primary"
          size="lg"
          block
          :loading="submitting"
          :disabled="!canSubmit"
          :text="submitText"
          @click="onSubmit"
        />
        <text v-if="!agreed" class="consent-reminder">勾选隐私政策后才能创建账号</text>
      </view>

      <view class="foot">
        <view class="foot-row" @click="onGoLogin">
          <text class="foot-text">已经有账号了？</text>
          <text class="foot-link">去登录</text>
        </view>
      </view>

      <view class="safe-gap" />
    </scroll-view>
  </view>
</template>

<script lang="uts" setup>
import { ref, computed } from 'vue'
import { useAppStore } from '@/stores/app'
import AppNavBar from '@/components/AppNavBar.uvue'
import AppInput from '@/components/AppInput.uvue'
import AppButton from '@/components/AppButton.uvue'
import { useAuthStore } from '@/stores/auth'
import { messageOfError, messageOf, CODE } from '@/core/http/error-code'
import { cancelByKey, setAbortScope, clearAbortScope } from '@/core/http/cancel'

const themeClass = computed<string>(() => useAppStore().isDark ? 'theme-dark' : 'theme-light')

/** ★ 与 pages.json 的 path 一致，作为本页在途请求的取消分组键 */
const PAGE_KEY: string = 'pages/register/register'

/** 密码强度档位 */
type Strength = 'none' | 'weak' | 'medium' | 'strong'

/** 与后端 PASSWORD_WEAK（10008）同口径：至少 8 位且含字母与数字 */
const MIN_LENGTH = 8

const authStore = useAuthStore()

/** 已登录用户本页（守卫白名单）也能进，给出「退出并切换」入口 */
const showLoggedIn = computed<boolean>(() => authStore.isLoggedIn)
/** 当前登录的昵称，给切号条展示 */
const displayName = computed<string>(() => authStore.displayName)

const phone = ref<string>('')
const password = ref<string>('')
const confirm = ref<string>('')
const nickname = ref<string>('')
const agreed = ref<boolean>(false)
const submitting = ref<boolean>(false)
const bannerError = ref<string>('')

// ────────────────────────────────────────────────────────
// 校验
// ────────────────────────────────────────────────────────

const phoneError = computed<string>(() => {
  if (phone.value.length == 0) return ''
  if (phone.value.length != 11) return messageOf(CODE.PHONE_INVALID)
  return ''
})

const pwdError = computed<string>(() => {
  if (password.value.length == 0) return ''
  if (password.value.length < MIN_LENGTH) return messageOf(CODE.PASSWORD_WEAK)
  // ★ 与后端 PASSWORD_WEAK（10008）同口径：必须同时含字母与数字。
  //   此前只查长度，纯数字密码（如手机号本身）能过本地校验、
  //   到后端才被拒，用户看到的还是笼统报错——必须在端上就拦住。
  if (!hasLetter(password.value) || !hasDigit(password.value)) {
    return messageOf(CODE.PASSWORD_WEAK)
  }
  return ''
})

/** 两次密码不一致：只在校验了确认框之后才提示，
 *  否则用户刚点完确认键还没输完就被判「不一致」，很烦 */
const confirmError = computed<string>(() => {
  if (confirm.value.length == 0) return ''
  if (confirm.value != password.value) return '两次输入的密码不一样'
  return ''
})

/** 强度：长度 + 字母 + 数字三个维度。
 *  只做「提示」，真正的准入判定在 pwdError 与后端。 */
const strength = computed<Strength>(() => {
  const p = password.value
  if (p.length == 0) return 'none'

  let score = 0
  if (p.length >= MIN_LENGTH) score += 1
  if (p.length >= 12) score += 1
  if (hasLetter(p) && hasDigit(p)) score += 1

  if (score <= 1) return 'weak'
  if (score == 2) return 'medium'
  return 'strong'
})

const strengthLabel = computed<string>(() => {
  const s = strength.value
  if (s == 'weak') return '弱'
  if (s == 'medium') return '中'
  if (s == 'strong') return '强'
  return ''
})

const strengthClass = computed<string>(() => {
  return 'strength-fill--' + strength.value
})

const strengthTextClass = computed<string>(() => {
  return 'strength-text--' + strength.value
})

/** 强度条的 hint 文案。放在 hint 而不是单独一行，是为了不给密码框再加噪 */
const pwdHint = computed<string>(() => {
  if (password.value.length == 0) return '至少 8 位，含字母和数字'
  return ''
})

const canSubmit = computed<boolean>(() => {
  if (!agreed.value) return false
  if (phone.value.length != 11) return false
  if (password.value.length < MIN_LENGTH) return false
  // ★ 纯数字/纯字母都过不了后端，本地直接不放行
  if (!hasLetter(password.value) || !hasDigit(password.value)) return false
  if (confirm.value != password.value) return false
  return true
})

const submitText = computed<string>(() => {
  return submitting.value ? '正在创建' : '创建账号'
})

function hasLetter(s: string): boolean {
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i)
    // A-Z / a-z
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) return true
  }
  return false
}

function hasDigit(s: string): boolean {
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i)
    if (c >= 48 && c <= 57) return true
  }
  return false
}

// ────────────────────────────────────────────────────────
// 生命周期
// ────────────────────────────────────────────────────────

onLoad(() => {
  // ★ 设置自动取消域：本页发起的所有请求都会归到该 key 下，
  //   onUnload 时 cancelByKey 一次性取消，避免回调写到已销毁的页面上
  setAbortScope(PAGE_KEY)
  bannerError.value = ''
})

onUnload(() => {
  // ★ 先清域再取消：清掉后续请求的自动归属，再按 key 取消在途请求。
  //   注册请求不能比页面活得久，否则用户已离开还会被提示「手机号已注册」
  clearAbortScope()
  cancelByKey(PAGE_KEY)
})

// ────────────────────────────────────────────────────────
// 提交
// ────────────────────────────────────────────────────────

async function onSubmit(): Promise<void> {
  if (submitting.value) return
  if (!canSubmit.value) {
    // disabled 时按钮不会抛 click，这行是给「勾选瞬间状态还没刷新」的兜底
    bannerError.value = '还有几项没填完'
    return
  }

  submitting.value = true
  bannerError.value = ''

  try {
    // 昵称为空就不传：后端昵称是可选的，传空串会存下一个空昵称
    const nick = nickname.value.trim()
    await authStore.register(phone.value, password.value, nick.length > 0 ? nick : undefined)
    // ★ 注册成功即登录（后端 register 直接返回令牌对），直接进首页。
    //   用 reLaunch 清空页面栈（含登录/注册页）；首页是 tabBar 页，
    //   redirectTo 不允许跳 tabBar 页且 url 必须带前导 `/`（均已踩坑）。
    uni.reLaunch({
      url: '/pages/index/index',
      fail: () => {
        console.error('[register] 注册成功但跳转首页失败')
        uni.showToast({ title: '账号已创建，稍后手动返回', icon: 'none' })
      },
    })
  } catch (e) {
    // ★ 不吞错误：横幅给用户，日志给开发
    console.error('[register] 注册失败', e)
    bannerError.value = messageOfError(e)
  } finally {
    // 失败也要解锁，否则按钮永远转圈
    submitting.value = false
  }
}

// ────────────────────────────────────────────────────────
// 其他入口
// ────────────────────────────────────────────────────────

function onToggleConsent(): void {
  agreed.value = !agreed.value
  if (agreed.value) bannerError.value = ''
}

function onGoPrivacy(): void {
  uni.navigateTo({
    url: '/pages/privacy/privacy',
    fail: () => {
      console.error('[register] 跳转隐私政策失败')
      uni.showToast({ title: '页面还没打开，请稍后再试', icon: 'none' })
    },
  })
}

function onGoLogin(): void {
  // 已经在登录流程里了，用 redirectTo 换掉而不是压栈，
  // 免得返回时在登录/注册之间来回跳
  uni.redirectTo({
    url: '/pages/login/login',
    fail: () => {
      console.error('[register] 返回登录页失败')
      uni.showToast({ title: '页面还没打开，请稍后再试', icon: 'none' })
    },
  })
}

/**
 * 已登录时点「退出并切换」：清掉当前登录态，回到登录页换号。
 * 注册页在守卫白名单里，已登录用户也能进来（例如想换号），
 * 这时给一个直接的退出入口，不必绕到「设置 → 账号 → 退出账号」。
 */
async function onSwitchAccount(): Promise<void> {
  try {
    await authStore.logout()
  } catch (e) {
    console.error('[register] 退出失败', e)
  }
  uni.reLaunch({
    url: '/pages/login/login',
    fail: () => {
      console.error('[register] 退出后回登录页失败')
      uni.showToast({ title: '已退出', icon: 'none' })
    },
  })
}
</script>

<style scoped lang="scss">
@use '../../styles/tokens.scss' as t;
@use '../../styles/mixins.scss' as m;

.page {
  flex: 1;
  background-color: var(--color-bg);
}

// ★ 不用 vh 单位
.body {
  flex: 1;
  width: 100%;
}

// ── 头部 ─────────────────────────────────────────────────
.head {
  width: 100%;
  @include m.content-constrain;
  flex-direction: column;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
  padding-top: t.$space-lg;
  padding-bottom: t.$space-lg;
}

.head-title {
  font-size: t.$font-lg;
  font-weight: t.$weight-bold;
  line-height: t.$line-height-tight;
  color: var(--color-text-1);
}

.head-sub {
  margin-top: t.$space-xs;
  font-size: t.$font-sm;
  line-height: t.$line-height-normal;
  color: var(--color-text-2);
}

// ── 表单 ─────────────────────────────────────────────────
.form {
  width: 100%;
  @include m.content-constrain;
  flex-direction: column;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
}

.gap {
  height: t.$space-md;
}

// ── 密码强度 ─────────────────────────────────────────────
.strength {
  flex-direction: row;
  align-items: center;
  margin-top: t.$space-xs;
}

.strength-bar {
  flex: 1;
  height: t.$space-xxs;
  border-radius: t.$radius-pill;
  background-color: var(--color-track);
  overflow: hidden;
}

.strength-fill {
  height: 100%;
  width: 33%;
  border-radius: t.$radius-pill;
}

.strength-text {
  margin-left: t.$space-xs;
  min-width: t.$space-lg;
  font-size: t.$font-xs;
  line-height: t.$line-height-tight;
  text-align: right;
}

// 三档宽度固定，不用百分比动态算：
// 强度条的意义是「一眼分档」，不是「精确打分」
.strength-fill--none {
  width: 0;
  background-color: var(--color-track);
}

.strength-fill--weak {
  width: 33%;
  background-color: var(--color-danger);
}

.strength-fill--medium {
  width: 66%;
  background-color: var(--color-warning);
}

.strength-fill--strong {
  width: 100%;
  background-color: var(--color-success);
}

.strength-text--none {
  color: var(--color-text-3);
}

.strength-text--weak {
  color: var(--color-danger);
}

.strength-text--medium {
  color: var(--color-warning);
}

.strength-text--strong {
  color: var(--color-success);
}

// ── 隐私勾选 ─────────────────────────────────────────────
.consent {
  width: 100%;
  @include m.content-constrain;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
  padding-top: t.$space-lg;
}

.consent-row {
  // ★ 勾选框本体小，但可点区域必须够大
  min-height: t.$tap-min-size;
  flex-direction: row;
  align-items: center;
}

.checkbox {
  width: t.$space-lg;
  height: t.$space-lg;
  border-radius: t.$radius-xs;
  // 1px 边框是全项目唯一允许的 px 字面量
  border-width: 1px;
  border-style: solid;
  border-color: var(--color-divider-strong);
  align-items: center;
  justify-content: center;
}

.checkbox--on {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox-tick {
  font-size: t.$font-sm;
  line-height: t.$line-height-tight;
  color: var(--color-text-on-primary);
}

.consent-text {
  margin-left: t.$space-sm;
  font-size: t.$font-sm;
  line-height: t.$line-height-normal;
  color: var(--color-text-2);
}

.consent-link {
  // 「《隐私政策》」是链接，给足点击区
  min-height: t.$tap-min-size;
  justify-content: center;
  padding-left: t.$space-xs;
  padding-right: t.$space-xs;
}

.consent-link-text {
  font-size: t.$font-sm;
  line-height: t.$line-height-normal;
  color: var(--color-primary);
  text-decoration: underline;
}

// ── 错误横幅 ─────────────────────────────────────────────
.banner {
  width: 100%;
  @include m.content-constrain;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
  padding-top: t.$space-md;
}

.banner-box {
  @include m.glass-card(t.$radius-md);
  padding: t.$space-sm;
  background-color: var(--color-danger-soft);
}

.banner-text {
  font-size: t.$font-sm;
  line-height: t.$line-height-normal;
  color: var(--color-danger);
}

// ── 主操作 ───────────────────────────────────────────────
.actions {
  width: 100%;
  @include m.content-constrain;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
  padding-top: t.$space-lg;
}

.consent-reminder {
  margin-top: t.$space-sm;
  font-size: t.$font-xs;
  line-height: t.$line-height-normal;
  color: var(--color-text-3);
  text-align: center;
}

// ── 底部入口 ─────────────────────────────────────────────
.foot {
  width: 100%;
  @include m.content-constrain;
  flex-direction: column;
  align-items: center;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
  padding-top: t.$space-md;
}

.foot-row {
  min-height: t.$tap-min-size;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.foot-text {
  font-size: t.$font-sm;
  line-height: t.$line-height-normal;
  color: var(--color-text-2);
}

.foot-link {
  font-size: t.$font-sm;
  font-weight: t.$weight-semibold;
  line-height: t.$line-height-normal;
  color: var(--color-primary);
  margin-left: t.$space-xs;
}

// ── 底部安全区 ───────────────────────────────────────────
.safe-gap {
  @include m.safe-bottom(t.$space-lg);
  width: 100%;
}

// ── 已登录切号条 ─────────────────────────────────────────
.switch-bar {
  width: 100%;
  @include m.content-constrain;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: t.$space-lg;
  padding-right: t.$space-lg;
  padding-top: t.$space-md;
  padding-bottom: t.$space-xs;
}

.switch-text {
  flex: 1;
  font-size: t.$font-sm;
  line-height: t.$line-height-normal;
  color: var(--color-text-2);
}

.switch-action {
  @include m.tap-target;
  padding-left: t.$space-sm;
  padding-right: t.$space-sm;
}

.switch-action-text {
  font-size: t.$font-sm;
  font-weight: t.$weight-semibold;
  line-height: t.$line-height-tight;
  color: var(--color-primary);
}
</style>
