}

// 极性三色。刻意用「冰川蓝 / 灰 / 暖橙」而不是「绿=好 / 红=坏」，
// 因为正负情绪没有优劣之分，绿色会暗示「开心才是对的」
.polarity-dot {
  width: t.$space-sm;
  height: t.$space-sm;
  border-radius: t.$radius-pill;
}

.polarity-dot--positive {
  background-color: var(--color-glacier);
}

