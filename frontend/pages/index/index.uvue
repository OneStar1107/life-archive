  font-size: t.$font-xs;
  line-height: t.$line-height-normal;
  color: var(--color-text-3);
}

// 骨架态的占位块：宽度用百分比，天然适配不同屏宽，不需要写死数值
.greet-line {
  height: t.$font-xxl;
  border-radius: t.$radius-sm;
  background-color: var(--color-skeleton);
