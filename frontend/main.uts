// main.uts
// ══════════════════════════════════════════════════════════════
// 应用入口
// ══════════════════════════════════════════════════════════════
//
// ★ 隐私合规铁律（03 号 T9 / 00 号第 ⑨ 节第 11 条）：
//   首启必须弹隐私政策同意弹窗，**未同意前不得调用任何获取设备信息的 API**。
//   因此创建 Vue 应用之前不做任何设备探测。

import { createSSRApp } from 'vue'
import { createPinia } from 'pinia'
import App from './App.uvue'

// ★★ 本文件中 `createSSRApp` 这个词的**第一处出现必须是上面那行 import**，
//    注释里不允许在 import 之前写出这个词。原因（2026-10-05 实测）：
//    uni-h5-vite 入口插件（@dcloudio/uni-h5-vite/dist/plugins/mainJs.js）对
//    **非 SSR** 的 H5 构建走
//      code.replace('createSSRApp', 'createVueApp as createSSRApp')
//    把入口换成 uni 自己导出的 createVueApp（= 普通 createApp，不水合）。
//    JS 的 String.replace 传字符串时**只替换第一处**。以前这句注释写在
//    import 之前且含该词，替换就打在了注释上，真正的 import 仍是 SSR 版，
//    mount('#app') 于是走 hydration；而 index.html 的 #app 里只有占位注释
//    <!--app-html-->（只有 SSR 构建才会把它替换成真实 HTML），两边对不上，
//    每次冷启动稳定报
//      [Vue warn]: Hydration node mismatch:
//      - rendered on server: [object Comment]
//      - expected on client: uni-app
//      Hydration completed but contains mismatches.
//    水合失败后 Vue 会退化成整树重挂（功能不受影响），但这条 console.error
//    会长期占据控制台，掩盖真正需要关注的问题。
//    原生三端不经过这个插件，不受影响。

export function createApp() {
  const app = createSSRApp(App)
  const pinia = createPinia()

  app.use(pinia)

  return {
    app,
    // Pinia 必须在其他插件之前
    pinia,
  }
}
