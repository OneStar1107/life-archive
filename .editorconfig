# ── 人生档案 · 冰川记忆 ──────────────────────
# 统一缩进：前端 .uvue/.uts/.scss 用 2 空格；后端 .ts 用 2 空格
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,json5,jsonc}]
indent_size = 2

[*.yml]
indent_size = 2

[Makefile]
indent_style = tab
