# ══════════════════════════════════════════════════════════════
# 人生档案 · 冰川记忆 —— 后端环境变量样例
# ══════════════════════════════════════════════════════════════
# ⚠️ 本文件是 .env 的模板，真实值一律留空。
# ⚠️ 复制为 .env 后填入本地开发值；.env 已被 .gitignore 忽略，绝不入库。
# ⚠️ 下表所有示例值【禁止用于生产环境】。
# ══════════════════════════════════════════════════════════════

# ── 运行环境 ────────────────────────────────
# development | staging | production
# 生产环境严禁使用 development（后端会启用更严格的校验）
NODE_ENV=development
# 后端监听端口
PORT=3000
# 允许跨域的前端来源，多个用英文逗号分隔
# ⚠️ 生产环境必须改成真实前端域名，禁止用 *
CORS_ORIGINS=http://localhost:5173

# ── 数据库 ──────────────────────────────────
# PostgreSQL 16 连接串。密码与库名从 docker-compose 的 .env 读取
# ⚠️ 下方示例值仅用于本地开发，禁止用于生产环境
DATABASE_URL=postgresql://lifearchive:LifearchiveLocalDev2026@localhost:5432/lifearchive?schema=public
# Prisma 迁移日志输出级别
PRISMA_LOG_LEVEL=warn

# ── Redis（可选，用于令牌黑名单与分布式限流）──
# 未部署 Redis 时留空，服务会自动降级为内存实现
# ⚠️ 下方示例值仅用于本地开发，禁止用于生产环境
REDIS_URL=

# ── JWT 双 Token ────────────────────────────
# ⚠️⚠️ 三个密钥必须替换为随机值，长度 ≥32 字符
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ 下方值为占位，禁止用于生产环境
JWT_SECRET=replace_me_with_random_64_chars_minimum_placeholder
JWT_REFRESH_SECRET=replace_me_with_random_64_chars_minimum_placeholder
# Access Token 有效期（秒）。默认 900 = 15 分钟，硬上限 1800 = 30 分钟
ACCESS_TTL=900
# Refresh Token 有效期（秒）。默认 604800 = 7 天
REFRESH_TTL=604800
# bcrypt 加盐强度，成本 ≥12
BCRYPT_COST=12

# ── 限流 ────────────────────────────────────
# 全局默认：窗口秒数 / 窗口内最大请求数
THROTTLE_TTL=60
THROTTLE_LIMIT=120
# 登录/注册/短信等敏感接口：窗口秒数 / 窗口内最大请求数
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=5

# ── 文件上传 ────────────────────────────────
# 上传根目录。⚠️ 禁止设在项目目录内，默认指向仓库外的 D:\certs 之外的独立目录
UPLOAD_ROOT=D:/lifearchive-uploads
# 单文件大小上限（字节）。默认 10MB
UPLOAD_MAX_SIZE=10485760
# 允许的 MIME 白名单，逗号分隔
UPLOAD_MIME_WHITELIST=image/jpeg,image/png,image/webp,image/heic

# ── 业务常量 ────────────────────────────────
# 应用名称（须与软著 / APP 备案 / 商店展示名一字不差）
APP_NAME=人生档案
# 应用包名（三端统一）
APP_BUNDLE_ID=com.lifearchive.app
# 主体名称 ⚠️ TODO(待补充)：填写营业执照主体全称，软著/备案/开发者账号必须同一主体
APP_ENTITY_NAME=待补充：营业执照主体全称
# 后端对外访问域名（须已 ICP 备案）
API_BASE_URL=https://api.lifearchive.cn
# 隐私政策地址（必须是独立可访问的 https 网页）
PRIVACY_POLICY_URL=https://www.lifearchive.cn/privacy
# 联系邮箱（隐私政策与商店审核共用）
SUPPORT_EMAIL=TODO(待补充):support@lifearchive.cn

# ── 日志 ────────────────────────────────────
# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# 部署环境：local | docker | k8s
LOG_DEPLOY_ENV=local
